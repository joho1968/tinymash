{extends './layout.latte'}

{block content}
    <article class="tm-scribe-reading tm-scribe-entry{if ! empty( $entry['is_photo_post'] )} tm-entry-photo-post tm-scribe-photo-post{/if}{if ! empty( $entry['has_photo_gallery'] )} tm-entry-has-photo-gallery tm-scribe-has-photo-gallery{/if}">
        {if ! empty( $entry_breadcrumbs ) && ! empty( $theme_breadcrumbs_enabled )}
            <nav aria-label="Breadcrumb" class="tm-scribe-breadcrumb mb-4">
                <ol class="breadcrumb small mb-0">
                    <li class="breadcrumb-item"><a href="{$home_url}">Home</a></li>
                    {foreach $entry_breadcrumbs as $breadcrumb}
                        <li n:class="'breadcrumb-item', $iterator->last ? 'active'" n:attr="aria-current => $iterator->last ? 'page' : null">
                            {if $iterator->last}
                                {$breadcrumb['title']}
                            {else}
                                <a href="{$breadcrumb['url']}">{$breadcrumb['title']}</a>
                            {/if}
                        </li>
                    {/foreach}
                </ol>
            </nav>
        {/if}

        <header class="tm-scribe-entry-header">
            {if ! empty( $entry['content_heading_html'] )}
                {$entry['content_heading_html']|noescape}
            {else}
                <h1>{$entry['title_html']|noescape}</h1>
            {/if}
            <div class="tm-scribe-meta mt-3">
                {if $entry['scope'] === 'author' && ! empty( $entry['author_slug'] )}
                    <span>By <a href="/{$entry['author_slug']}">{$entry['author_display_name'] ?? $entry['author_slug']}</a></span>
                {/if}
                {if ! empty( $entry['show_entry_timestamps'] ) && ! empty( $entry['published_at_display'] )}
                    <span>{$entry['published_at_display']}</span>
                {/if}
                {if ! empty( $entry['show_entry_timestamps'] ) && ! empty( $entry['updated_at_display'] ) && $entry['updated_at_display'] !== $entry['published_at_display']}
                    <span>Updated {$entry['updated_at_display_without_timezone'] ?? $entry['updated_at_display']}</span>
                {/if}
                {if ! empty( $entry['sticky'] )}
                    <span>Pinned</span>
                {/if}
            </div>
            {if ! empty( $theme_tags['enabled'] ) && ! empty( $entry['tag_links'] )}
                <div class="tm-scribe-tags mt-3">
                    {foreach $entry['tag_links'] as $tag_link}
                        <a href="{$tag_link['url']}">#{$tag_link['label']}</a>
                    {/foreach}
                </div>
            {/if}
        </header>

        {if ! empty( $entry_navigation ) || ! empty( $entry_can_edit )}
            <nav class="tm-scribe-entry-navigation my-4 py-3" aria-label="Entry">
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <a n:if="! empty( $entry_navigation['back_url'] )" href="{$entry_navigation['back_url']}">{$entry_navigation['back_label'] ?? 'Back'}</a>
                    <a n:if="! empty( $entry_can_edit ) && ! empty( $entry_edit_url )" class="btn btn-outline-primary btn-sm" href="{$entry_edit_url}">Edit</a>
                    <span class="d-flex flex-wrap gap-3 ms-auto">
                        <a n:if="! empty( $entry_navigation['previous'] )" href="{$entry_navigation['previous']['url']}" rel="prev"><span aria-hidden="true">←</span> Previous</a>
                        <a n:if="! empty( $entry_navigation['next'] )" href="{$entry_navigation['next']['url']}" rel="next">Next <span aria-hidden="true">→</span></a>
                    </span>
                </div>
            </nav>
        {/if}

        <div class="entry-content tm-scribe-prose{if ($entry['type'] ?? 'post') === 'post' && ($theme_settings['post_image_alignment'] ?? 'as_written') === 'centered'} tm-scribe-prose-images-centered{/if}" data-tm-syntax-root n:attr="data-tm-syntax-language-labels => ! empty( $theme_syntax_highlighting['language_labels'] ) ? '1' : null, data-tm-syntax-language-label-class => ! empty( $theme_syntax_highlighting['language_label_class'] ) ? $theme_syntax_highlighting['language_label_class'] : null">
            {$entry['content_body_html']|noescape}
        </div>

        {if ! empty( $entry_child_pages ) && ! empty( $theme_child_pages_enabled )}
            <section class="tm-scribe-after-content mt-5 pt-4">
                <h2 class="h4 mb-3">{$theme_child_pages_heading}</h2>
                <ul class="list-unstyled d-grid gap-2 mb-0">
                    {foreach $entry_child_pages as $child_page}
                        <li><a href="{$child_page['url']}">{$child_page['title']}</a></li>
                    {/foreach}
                </ul>
            </section>
        {/if}
    </article>
{/block}
