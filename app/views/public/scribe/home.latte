{extends './layout.latte'}

{block content}
    {if ! empty( $landing_entry ) }
        <article class="tm-scribe-reading tm-scribe-entry">
            <header class="tm-scribe-entry-header mb-4">
                {if ! empty( $landing_entry['content_heading_html'] )}
                    {$landing_entry['content_heading_html']|noescape}
                {else}
                    <h1>{$landing_entry['title_html']|noescape}</h1>
                {/if}
            </header>
            <div class="tm-scribe-prose" data-tm-syntax-root n:attr="data-tm-syntax-language-labels => ! empty( $theme_syntax_highlighting['language_labels'] ) ? '1' : null, data-tm-syntax-language-label-class => ! empty( $theme_syntax_highlighting['language_label_class'] ) ? $theme_syntax_highlighting['language_label_class'] : null">
                {$landing_entry['content_body_html']|noescape}
            </div>
            {if ! empty( $landing_entry_child_pages ) && ! empty( $theme_child_pages_enabled ) }
                <section class="tm-scribe-after-content mt-5 pt-4">
                    <h2 class="h4 mb-3">{$theme_child_pages_heading}</h2>
                    <ul class="list-unstyled d-grid gap-2 mb-0">
                        {foreach $landing_entry_child_pages as $child_page}
                            <li><a href="{$child_page['url']}">{$child_page['title']}</a></li>
                        {/foreach}
                    </ul>
                </section>
            {/if}
        </article>
    {else}
        <div class="tm-scribe-reading">
            {if empty( $listing_context_title )}
                <h1 class="visually-hidden">Latest posts</h1>
            {/if}
            {if ! empty( $listing_context_title ) || ! empty( $listing_context_summary )}
                <header class="tm-scribe-listing-context mb-5">
                    {if ! empty( $listing_context_title )}
                        <h1 class="mb-2">{$listing_context_title}</h1>
                    {/if}
                    {if ! empty( $listing_context_summary )}
                        <div class="tm-scribe-deck text-body-secondary">{$listing_context_summary}</div>
                    {/if}
                </header>
            {/if}
            {if empty( $entries )}
                <p class="text-body-secondary mb-0">{$listing_empty_message ?? 'No published posts are currently aggregated to the front page.'}</p>
            {else}
                <section class="tm-scribe-stream">
                    {foreach $entries as $entry}
                        <article class="tm-scribe-story">
                            <header>
                                <div n:if="! empty( $entry['sticky'] )" class="tm-scribe-kicker">Pinned</div>
                                <h2><a href="{$entry['url']}">{$entry['title_html']|noescape}</a></h2>
                                <div class="tm-scribe-meta">
                                    {if $entry['scope'] === 'author'}
                                        <span>By <a href="/{$entry['author_slug']}">{$entry['author_display_name'] ?? $entry['author_slug']}</a></span>
                                    {/if}
                                    {if ! empty( $entry['published_at_display'] )}
                                        <span>{$entry['published_at_display']}</span>
                                    {/if}
                                </div>
                            </header>
                            {if ! empty( $entry['featured_image']['url'] )}
                                <a class="tm-scribe-listing-image" href="{$entry['url']}">
                                    <img src="{$entry['featured_image']['thumbnail_url'] ?? $entry['featured_image']['url']}" alt="{$entry['featured_image']['alt_text'] ?? ''}" loading="lazy" decoding="async"{if ! empty( $entry['featured_image']['thumbnail_width'] )} width="{$entry['featured_image']['thumbnail_width']}"{elseif ! empty( $entry['featured_image']['width'] )} width="{$entry['featured_image']['width']}"{/if}{if ! empty( $entry['featured_image']['thumbnail_height'] )} height="{$entry['featured_image']['thumbnail_height']}"{elseif ! empty( $entry['featured_image']['height'] )} height="{$entry['featured_image']['height']}"{/if}>
                                </a>
                            {/if}
                            {if ! empty( $entry['summary_html'] )}
                                <div class="tm-scribe-summary" data-tm-syntax-root n:attr="data-tm-syntax-language-labels => ! empty( $theme_syntax_highlighting['language_labels'] ) ? '1' : null, data-tm-syntax-language-label-class => ! empty( $theme_syntax_highlighting['language_label_class'] ) ? $theme_syntax_highlighting['language_label_class'] : null">{$entry['summary_html']|noescape}</div>
                            {/if}
                            {if ! empty( $theme_tags['enabled'] ) && ! empty( $entry['tag_links'] )}
                                <div class="tm-scribe-tags">
                                    {foreach $entry['tag_links'] as $tag_link}
                                        <a href="{$tag_link['url']}">#{$tag_link['label']}</a>
                                    {/foreach}
                                </div>
                            {/if}
                            <a class="tm-scribe-read" href="{$entry['url']}">Continue reading <span aria-hidden="true">→</span></a>
                        </article>
                    {/foreach}
                </section>
                {include '../baseline/partials/listing-pagination.latte', listing_pagination: $listing_pagination ?? []}
            {/if}
        </div>
    {/if}
{/block}
