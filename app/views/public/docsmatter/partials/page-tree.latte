{if ! empty( $pages )}
    {var $tree_branch_url = trim((string) ($tree_branch_url ?? ''))}
    {var $tree_branch_hidden = ! empty($tree_branch_hidden ?? false)}
    <div n:class="($level ?? 1) > 1 ? 'd-grid gap-1 mt-1 ps-3 ms-2 border-start tm-docsmatter-page-tree-nested' : 'd-grid gap-1 tm-docsmatter-page-tree-root'"
        n:attr="hidden => $tree_branch_hidden ? true : null, data-tm-docsmatter-page-branch => $tree_branch_url !== '' ? $tree_branch_url : null, data-tm-docsmatter-page-branch-active => $tree_branch_url !== '' && ! $tree_branch_hidden ? '1' : null">
        {foreach $pages as $page}
            <div class="tm-docsmatter-page-node">
                <a n:class="$page['is_current'] ? 'tm-docsmatter-page-link nav-link bs5docs-menu-item current active-nav' : ($page['is_ancestor'] ? 'tm-docsmatter-page-link nav-link bs5docs-menu-item ancestor active-nav' : 'tm-docsmatter-page-link nav-link bs5docs-menu-item')" href="{$page['url']}">{$page['title']}</a>
                {if ! empty( $page['children'] )}
                    {var $branch_expanded = ! empty( $page['is_current'] ) || ! empty( $page['is_ancestor'] )}
                    {include './page-tree.latte', pages: $page['children'], level: (($level ?? 1) + 1), tree_branch_url: (string) $page['url'], tree_branch_hidden: ! $branch_expanded}
                {/if}
            </div>
        {/foreach}
    </div>
{/if}
