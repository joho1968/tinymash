{extends './layout.latte'}

{block content}
    {var $message = trim((string) ($message ?? ''))}
    {var $login_url = trim((string) ($login_url ?? ''))}
    <div class="py-4">
        <div class="w-100">
            <div class="tm-timeline-panel text-center">
                <h1 class="tm-timeline-404-title mb-3">
                    <span class="tm-timeline-404-code">404</span> {$title}
                </h1>
                <div class="text-secondary">
                    {if $message !== ''}
                        {$message}
                    {else}
                        The requested page was not found.
                    {/if}
                </div>
                {if $login_url !== ''}
                    <div class="mt-3">
                        <a class="btn btn-outline-secondary btn-sm" href="{$login_url}">Log in</a>
                    </div>
                {/if}
            </div>
        </div>
    </div>
{/block}
