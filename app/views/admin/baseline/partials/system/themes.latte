<section class="p-3 bg-body border rounded-3">
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
        <div class="flex-grow-1 min-w-0">
            <div class="small text-uppercase text-body-secondary mb-2">Themes</div>
            <h2 class="h5 mb-1">Public theme</h2>
            <p class="text-body-secondary mb-0">Choosing Use this theme changes the live public presentation. Settings are saved per theme.</p>
        </div>
    </div>

    {if empty( $system_available_public_themes )}
        <div class="small text-body-secondary">No public themes are currently registered.</div>
    {else}
        <section aria-label="Available public themes">
            {foreach $system_available_public_themes as $available_theme}
                {var $theme_is_active = $available_theme['key'] === $system_theme_key}
                <article class="py-3 border-top">
                    <div class="d-flex flex-column flex-xl-row align-items-xl-start justify-content-between gap-3">
                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                <h3 class="h6 mb-0">{$available_theme['name']}</h3>
                                {if $theme_is_active}
                                    <span class="badge text-bg-success">Active</span>
                                {else}
                                    <span class="small text-body-secondary">Inactive</span>
                                {/if}
                                {if ! empty( $available_theme['manifest_warnings'] )}
                                    <span class="badge text-bg-warning">Manifest warnings</span>
                                {/if}
                            </div>

                            <div class="small text-body-secondary d-flex flex-wrap gap-2 mb-1">
                                <span class="font-monospace">{$available_theme['key']}</span>
                                {if ! empty( $available_theme['version'] )}
                                    <span aria-hidden="true">·</span>
                                    <span>{$available_theme['version']}</span>
                                {/if}
                                <span aria-hidden="true">·</span>
                                <span>{count( $available_theme['support_details'] ?? [] )} features</span>
                                {if ! empty( $available_theme['manifest_warnings'] )}
                                    <span aria-hidden="true">·</span>
                                    <span>{count( $available_theme['manifest_warnings'] )} warnings</span>
                                {/if}
                            </div>

                            {if ! empty( $available_theme['description'] )}
                                <div class="small text-body-secondary">{$available_theme['description']}</div>
                            {/if}

                            {if ! empty( $available_theme['manifest_warnings'] )}
                                <div class="small text-warning-emphasis mt-2">
                                    <div class="fw-semibold mb-1">Manifest warnings</div>
                                    <ul class="mb-0 ps-3">
                                        {foreach $available_theme['manifest_warnings'] as $theme_manifest_warning}
                                            <li>{$theme_manifest_warning}</li>
                                        {/foreach}
                                    </ul>
                                </div>
                            {/if}
                        </div>

                        <div class="d-flex flex-wrap flex-xl-nowrap flex-xl-shrink-0 align-items-start justify-content-xl-end gap-2">
                            {if ! empty( $available_theme['support_details'] )}
                                <button class="btn btn-outline-secondary btn-sm text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#tm-theme-supports-{$available_theme['key']}">Features</button>
                            {/if}
                            {if $theme_is_active}
                                <a class="btn btn-primary btn-sm text-nowrap" href="{$system_section_urls['themes_settings']}">Edit settings</a>
                            {else}
                                <form method="post" action="{$system_theme_select_url}">
                                    <input type="hidden" name="tinymash_csrf" value="{$csrf_token}">
                                    <input type="hidden" name="theme_key" value="{$available_theme['key']}">
                                    <button class="btn btn-primary btn-sm text-nowrap" type="submit">Use this theme</button>
                                </form>
                            {/if}
                        </div>
                    </div>
                </article>

                {if ! empty( $available_theme['support_details'] )}
                    <div class="modal fade" id="tm-theme-supports-{$available_theme['key']}" tabindex="-1" aria-labelledby="tm-theme-supports-{$available_theme['key']}-label" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-scrollable">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <div>
                                        <div class="small text-uppercase text-body-secondary mb-1">Theme features</div>
                                        <h5 class="modal-title" id="tm-theme-supports-{$available_theme['key']}-label">{$available_theme['name']}</h5>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body d-grid gap-3">
                                    {if ! empty( $available_theme['description'] )}
                                        <p class="text-body-secondary mb-0">{$available_theme['description']}</p>
                                    {/if}
                                    <div class="d-grid gap-2">
                                        {foreach $available_theme['support_details'] as $available_theme_support}
                                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 p-2">
                                                <span>{$available_theme_support['label']}</span>
                                                <span class="badge {if ! empty( $available_theme_support['enabled'] )}text-bg-success{else}text-bg-secondary{/if}">
                                                    {if ! empty( $available_theme_support['enabled'] )}Enabled{else}Disabled{/if}
                                                </span>
                                            </div>
                                        {/foreach}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {/if}
            {/foreach}
        </section>
    {/if}
</section>
