{
    "key": "scribe",
    "name": "Scribe",
    "description": "Reading-focused theme for long-form publishing.",
    "version": "1.0.0",
    "author_name": "joho",
    "author_email": "joho+tinymash@boojam.se",
    "website": "https://tinymash.joho.se",
    "license": "AGPL-3.0-or-later",
    "template_root": "public/scribe",
    "views": {
        "home": "public/scribe/home.latte",
        "author-home": "public/scribe/author.home.latte",
        "entry-post": "public/scribe/entry.latte",
        "entry-page": "public/scribe/entry.latte",
        "404": "public/scribe/404.latte"
    },
    "css_urls": [
        "/ext/bs/css/bootstrap.min.css",
        "/ext/bsi/bootstrap-icons.min.css",
        "/css/tinymash.css",
        "/css/tinymash-scribe.css"
    ],
    "js_urls": [
        "/ext/bs/js/bootstrap.bundle.min.js"
    ],
    "supports": {
        "menus": true,
        "primary_menu": true,
        "sidebar_menu": true,
        "breadcrumbs": true,
        "page_sidebar": true,
        "after_content_child_pages": true,
        "footer_menu": true,
        "public_background": true,
        "syntax_highlighting": true
    },
    "settings_schema": [
        {
            "key": "header_position",
            "label": "Header position",
            "type": "select",
            "author_override": true,
            "default": "sticky",
            "options": [
                { "value": "sticky", "label": "Sticky" },
                { "value": "static", "label": "Scroll with content" }
            ],
            "help": "Keep the header visible while scrolling or let it scroll with the page. The banner always scrolls away."
        },
        {
            "key": "primary_menu_position",
            "label": "Primary menu position",
            "type": "select",
            "default": "header",
            "options": [
                { "value": "header", "label": "Header" },
                { "value": "sidebar", "label": "Sidebar" },
                { "value": "off", "label": "Off" }
            ],
            "help": "Show the primary menu in the header or sidebar, or hide it."
        },
        {
            "key": "footer_menu_position",
            "label": "Footer menu position",
            "type": "select",
            "default": "footer",
            "options": [
                { "value": "footer", "label": "Footer" },
                { "value": "off", "label": "Off" }
            ],
            "help": "Show the footer menu in the footer, or hide it."
        },
        {
            "key": "root_landing_mode",
            "label": "Site home page",
            "type": "select",
            "default": "blogroll",
            "options": [
                { "value": "blogroll", "label": "Blogroll" },
                { "value": "page", "label": "Static page" }
            ],
            "help": "Use the post list or a published page as the site home page."
        },
        {
            "key": "landing_page_path",
            "label": "Site home page content",
            "type": "text",
            "lookup": "published_pages",
            "default": "",
            "help": "Choose the published root page used when `Static page` is selected."
        },
        {
            "key": "content_width",
            "label": "Content width",
            "type": "select",
            "author_override": true,
            "default": "reading",
            "options": [
                { "value": "theme_default", "label": "Theme default" },
                { "value": "small", "label": "Small (600)" },
                { "value": "compact", "label": "Compact (720)" },
                { "value": "reading", "label": "Reading (840)" },
                { "value": "standard", "label": "Standard (960)" },
                { "value": "wide", "label": "Wide (1140)" },
                { "value": "full", "label": "Full" }
            ],
            "help": "Set the maximum width of the main content area."
        },
        {
            "key": "author_identity",
            "label": "Author identity in header",
            "type": "select",
            "author_override": true,
            "default": "name",
            "options": [
                { "value": "name", "label": "Display name" },
                { "value": "name_handle", "label": "Display name and handle" },
                { "value": "hidden", "label": "Hidden" }
            ],
            "help": "Show the author name, name and handle, or no author identity beside the site title."
        },
        {
            "key": "post_image_alignment",
            "label": "Standalone post images",
            "type": "select",
            "author_override": true,
            "default": "as_written",
            "options": [
                { "value": "as_written", "label": "As written" },
                { "value": "centered", "label": "Centered" }
            ],
            "help": "Center standalone images in full posts or keep their authored alignment."
        },
        {
            "key": "author_home_heading",
            "label": "Author home heading",
            "type": "select",
            "author_override": true,
            "default": "disabled",
            "options": [
                { "value": "enabled", "label": "Enabled" },
                { "value": "disabled", "label": "Disabled" }
            ],
            "help": "Show the author name above post lists on author home pages."
        },
        {
            "key": "author_social_links",
            "label": "Author social links in header",
            "type": "select",
            "author_override": true,
            "default": "disabled",
            "options": [
                { "value": "enabled", "label": "Enabled" },
                { "value": "disabled", "label": "Disabled" }
            ],
            "help": "Show Social profile links beside the author identity when the Social plugin is active."
        },
        {
            "key": "secondary_sidebar",
            "label": "Sidebar plugin output",
            "type": "select",
            "default": "disabled",
            "options": [
                { "value": "enabled", "label": "Enabled" },
                { "value": "disabled", "label": "Disabled" }
            ],
            "help": "Show plugin sidebar output beside the reading column."
        },
        {
            "key": "show_search",
            "label": "Public search",
            "type": "select",
            "default": "enabled",
            "options": [
                { "value": "enabled", "label": "Enabled" },
                { "value": "disabled", "label": "Disabled" }
            ],
            "help": "Show public search when the Search plugin is active."
        },
        {
            "key": "show_tags",
            "label": "Show tags",
            "type": "select",
            "default": "enabled",
            "options": [
                { "value": "enabled", "label": "Enabled" },
                { "value": "disabled", "label": "Disabled" }
            ],
            "help": "Show entry tags when tags are enabled for the site."
        },
        {
            "key": "enable_syntax_highlighting",
            "label": "Syntax highlighting",
            "type": "select",
            "requires_plugin": "syntax-highlighting",
            "default": "enabled",
            "options": [
                { "value": "enabled", "label": "Enabled" },
                { "value": "disabled", "label": "Disabled" }
            ],
            "help": "Highlight fenced code blocks with the local highlight.js assets."
        },
        {
            "key": "page_sidebar_style",
            "label": "Page sidebar style",
            "type": "select",
            "default": "disabled",
            "options": [
                { "value": "flat", "label": "Flat list" },
                { "value": "cards", "label": "Card tree" },
                { "value": "disabled", "label": "Disabled" }
            ],
            "help": "Show the published page tree as a flat list or card tree, or hide it."
        },
        {
            "key": "top_navigation_depth",
            "label": "Fallback page-tree depth",
            "type": "select",
            "default": "1",
            "options": [
                { "value": "disabled", "label": "Disabled" },
                { "value": "1", "label": "1st level" },
                { "value": "2", "label": "2nd level" },
                { "value": "3", "label": "3rd level" }
            ],
            "help": "Set the depth of the page tree shown in the header when no primary menu is configured."
        },
        {
            "key": "page_breadcrumbs",
            "label": "Page breadcrumbs",
            "type": "select",
            "default": "enabled",
            "options": [
                { "value": "enabled", "label": "Enabled" },
                { "value": "disabled", "label": "Disabled" }
            ],
            "help": "Show breadcrumb trails above page content."
        },
        {
            "key": "page_children_after_content",
            "label": "Child pages after content",
            "type": "select",
            "default": "subpages",
            "options": [
                { "value": "disabled", "label": "Disabled" },
                { "value": "more", "label": "More" },
                { "value": "subpages", "label": "Subpages" }
            ],
            "help": "List published child pages after page content."
        }
    ]
}
