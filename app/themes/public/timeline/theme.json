{
    "key": "timeline",
    "name": "Timeline",
    "description": "Archive theme with a vertical date rail.",
    "version": "1.0.0",
    "author_name": "joho",
    "author_email": "joho+tinymash@boojam.se",
    "website": "https://tinymash.joho.se",
    "license": "AGPL-3.0-or-later",
    "template_root": "public/timeline",
    "views": {
        "home": "public/timeline/home.latte",
        "author-home": "public/timeline/author.home.latte",
        "entry-post": "public/timeline/entry.latte",
        "entry-page": "public/timeline/entry.latte",
        "404": "public/timeline/404.latte"
    },
    "css_urls": [
        "/ext/bs/css/bootstrap.min.css",
        "/ext/bsi/bootstrap-icons.min.css",
        "/css/tinymash.css",
        "/css/tinymash-timeline.css"
    ],
    "js_urls": [
        "/ext/bs/js/bootstrap.bundle.min.js"
    ],
    "supports": {
        "menus": true,
        "primary_menu": true,
        "sidebar_menu": true,
        "breadcrumbs": true,
        "page_sidebar": true,
        "after_content_child_pages": true,
        "footer_menu": true,
        "public_background": true,
        "syntax_highlighting": true
    },
    "settings_schema": [
        {
            "key": "primary_menu_position",
            "label": "Primary menu position",
            "type": "select",
            "default": "header",
            "options": [
                { "value": "header", "label": "Header" },
                { "value": "sidebar", "label": "Sidebar" },
                { "value": "off", "label": "Off" }
            ],
            "help": "Show the primary menu in the header or sidebar, or hide it."
        },
        {
            "key": "footer_menu_position",
            "label": "Footer menu position",
            "type": "select",
            "default": "footer",
            "options": [
                { "value": "footer", "label": "Footer" },
                { "value": "off", "label": "Off" }
            ],
            "help": "Show the footer menu in the footer, or hide it."
        },
        {
            "key": "root_landing_mode",
            "label": "Site home page",
            "type": "select",
            "default": "blogroll",
            "options": [
                { "value": "blogroll", "label": "Blogroll" },
                { "value": "page", "label": "Static page" }
            ],
            "help": "Use the post list or a published page as the site home page."
        },
        {
            "key": "landing_page_path",
            "label": "Site home page content",
            "type": "text",
            "lookup": "published_pages",
            "default": "",
            "help": "Choose the published root page used when `Static page` is selected."
        },
        {
            "key": "content_width",
            "label": "Content width",
            "type": "select",
            "author_override": true,
            "default": "reading",
            "options": [
                { "value": "theme_default", "label": "Theme default" },
                { "value": "small", "label": "Small (600)" },
                { "value": "compact", "label": "Compact (720)" },
                { "value": "reading", "label": "Reading (840)" },
                { "value": "standard", "label": "Standard (960)" },
                { "value": "wide", "label": "Wide (1140)" },
                { "value": "full", "label": "Full" }
            ],
            "help": "Set the maximum width of the main content area."
        },
        {
            "key": "publication_title_style",
            "label": "Publication title style",
            "type": "select",
            "default": "sans-serif",
            "options": [
                { "value": "serif", "label": "Serif" },
                { "value": "sans-serif", "label": "Sans-serif" }
            ],
            "help": "Use serif or sans-serif type for the site identity and publication titles. Body text, navigation, and controls remain sans-serif."
        },
        {
            "key": "show_search",
            "label": "Public search",
            "type": "select",
            "default": "enabled",
            "options": [
                { "value": "enabled", "label": "Enabled" },
                { "value": "disabled", "label": "Disabled" }
            ],
            "help": "Show public search when the Search plugin is active."
        },
        {
            "key": "show_tags",
            "label": "Show tags",
            "type": "select",
            "default": "enabled",
            "options": [
                { "value": "enabled", "label": "Enabled" },
                { "value": "disabled", "label": "Disabled" }
            ],
            "help": "Show entry tags when tags are enabled for the site."
        },
        {
            "key": "enable_syntax_highlighting",
            "label": "Syntax highlighting",
            "type": "select",
            "requires_plugin": "syntax-highlighting",
            "default": "enabled",
            "options": [
                { "value": "enabled", "label": "Enabled" },
                { "value": "disabled", "label": "Disabled" }
            ],
            "help": "Highlight fenced code blocks with the local highlight.js assets."
        },
        {
            "key": "page_sidebar_style",
            "label": "Page sidebar style",
            "type": "select",
            "default": "cards",
            "options": [
                { "value": "flat", "label": "Flat list" },
                { "value": "cards", "label": "Card tree" },
                { "value": "disabled", "label": "Disabled" }
            ],
            "help": "Show the published page tree as a flat list or card tree, or hide it."
        },
        {
            "key": "top_navigation_depth",
            "label": "Fallback page-tree depth",
            "type": "select",
            "default": "1",
            "options": [
                { "value": "disabled", "label": "Disabled" },
                { "value": "1", "label": "1st level" },
                { "value": "2", "label": "2nd level" },
                { "value": "3", "label": "3rd level" }
            ],
            "help": "Set the depth of the page tree shown in the header when no primary menu is configured."
        },
        {
            "key": "page_breadcrumbs",
            "label": "Page breadcrumbs",
            "type": "select",
            "default": "enabled",
            "options": [
                { "value": "enabled", "label": "Enabled" },
                { "value": "disabled", "label": "Disabled" }
            ],
            "help": "Show breadcrumb trails above page content."
        },
        {
            "key": "page_children_after_content",
            "label": "Child pages after content",
            "type": "select",
            "default": "subpages",
            "options": [
                { "value": "disabled", "label": "Disabled" },
                { "value": "more", "label": "More" },
                { "value": "subpages", "label": "Subpages" }
            ],
            "help": "List published child pages after page content."
        }
    ]
}
